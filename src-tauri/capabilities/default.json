{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DevWorkbench capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "dialog:allow-open"
  ]
}
